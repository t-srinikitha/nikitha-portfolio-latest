{
  "redirects": [
    {
      "source": "/plastic",
      "destination": "/plasticoptics",
      "permanent": true
    },
    {
      "source": "/plastic/:path*",
      "destination": "/plasticoptics/:path*",
      "permanent": true
    },
    {
      "source": "/work-with-me",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/letter-to-self",
      "destination": "https://letter-to-self-t-srinikithas-projects.vercel.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/plasticoptics",
      "destination": "/plastic.html"
    },
    {
      "source": "/plasticoptics/:path*",
      "destination": "/plastic.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|@vite/|@react-refresh|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}